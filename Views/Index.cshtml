

@{
    ViewBag.Title = "Kewajiban Pelaporan";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}


<div class="modal" id="myModal">
    <div class="modal-dialog modal-lg">
        <form id="formInputIP">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header">
                    <h4 class="modal-title"></h4>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>

                <!-- Modal body -->
                <div class="modal-body">

                    <div class="form-horizontal">

                        <div class="form-group row">
                            <label class="col-sm-3 control-label text-right">Bank<span style="color:red"> *</span></label>
                            <div class="col-sm-8">
                                <select class="form-control" type="text" required id="dd_bank" name="dd_bank"></select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 control-label text-right">Jenis Kegiatan<span style="color:red"> *</span></label>
                            <div class="col-sm-8">
                                <input type="text" required id="dd_jeniskeg" class="form-control" name="dd_jeniskeg" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 control-label text-right">Status Kantor<span style="color:red"> *</span></label>
                            <div class="col-sm-8">
                                <select class="form-control" type="text" required id="dd_status" name="dd_status"></select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 control-label text-right">Id Pelapor<span style="color:red"> *</span></label>
                            <div class="col-sm-8">
                                <select style="width:92%" class="" type="text" id="dd_idpelapor" name="dd_idpelapor" multiple="multiple" placeholder="-- Pilih Idpelapor --"></select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 control-label text-right">Periode<span style="color:red"> *</span></label>
                            <div class="col-sm-8">
                                <select class="form-control input-sm" type="text" required id="dd_periode" name="dd_periode">
                                    <option value="">-- Pilih Data --</option>
                                    <option value="D">Harian</option>
                                    <option value="W">Mingguan</option>
                                    <option value="M">Bulanan</option>
                                    <option value="Q">Triwulanan</option>
                                    <option value="S">Semesteran</option>
                                    <option value="A">Tahunan</option>
                                </select>
                                <div id="msgkp"></div>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 control-label text-right">Informasi<span style="color:red"> *</span></label>
                            <div class="col-sm-8">
                                <select style="width:92%" class="" type="text" id="dd_informasi" name="dd_informasi" multiple="multiple" placeholder="-- Pilih Informasi --" disabled></select>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Modal footer -->
                <div class="modal-footer">
                    <button class="btn btn-default" id="btnClose" data-dismiss="modal">Tutup</button>
@*tambah ini untuk trustee button*@
                    @{
                        var tf = true;
                        foreach (var item in ViewBag.ButtonAcc)
                        {
                            if (item.MenuDesc == "Button New" || item.MenuDesc == "Button Update")
                            {
                                if (tf) { 
                                <button type="submit" id="id-btnsimpan" class="btn btn-primary">Simpan</button>
                                }
                                tf = false;
                            }
                        }
                    }
@*tambah ini untuk trustee button*@
                </div>

            </div>
        </form>
    </div>
</div>

<div class="modal" id="myModalConfirm">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-top-color:red;border-top-width: 4px;border-top-style: solid;">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Konfirmasi !</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <div class="form-horizontal">
                    <p>Apakah anda yakin ingin menghapus bank <b id="delBank"></b> ?</p>
                    <div class="row">
                        <div class="col-md-4 dtl-mdl"><b>Pilih Periode<span style="color:red"> *</span></b></div>
                        <div class="col-md-8 dtl-mdl">
                            <input type="hidden" id="idpelaporDel"/>
                            <select style="width:92%" class="" type="text" id="dd_periodeLap" multiple="multiple" placeholder="-- Pilih Periode --">
                                <option value="D">Harian</option>
                                <option value="W">Mingguan</option>
                                <option value="M">Bulanan</option>
                                <option value="Q">Triwulan</option>
                                <option value="S">Semesteran</option>
                                <option value="A">Tahunan</option>
                            </select>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button class="btn btn-default" id="btnClose" data-dismiss="modal">Tutup</button>
                <button id="id-btnsimpan" class="btn btn-danger" onclick="dltx()">Hapus</button>
                   
            </div>

        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">

            <div class="bgc-white bd bdrs-3 p-20 mB-20">
                <h4 class="c-grey-900 mB-20">@ViewBag.Title</h4>
                @{
                    foreach (var item in ViewBag.ButtonAcc)
                    {
                        if (item.MenuDesc == "Button New")
                        {
                            <button id="btnAdd" class="btn btn-sm btn-primary">Atur</button>
                        }
                    }
                }
                <br />
                <br />
                <div id="div-dtTbl">
                    <table id="dataTableIP" class="table table-condensed  table-sm table-striped table-bordered" cellspacing="0" width="100%">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th width="10%">Bank</th>
                                <th>Jenis Kegiatan</th>
                                <th>Status Kantor</th>
                                <th width="30%">Harian</th>
                                <th width="20%">Mingguan</th>
                                <th width="20%">Bulanan</th>
                                <th width="20%">Triwulan</th>
                                <th width="20%">Semesteran</th>
                                <th width="20%">Tahunan</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>

                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

