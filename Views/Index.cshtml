    var ifg;
    function senddt() {
        var idata;
        idata = {
            IdPelapor: (ifg == "Atur") ? $("#dd_idpelapor").val().join(',') : $("#dd_idpelapor").val(),
            PeriodInformation: $("#dd_informasi").val().join('|'),
            Periode: $("#dd_periode").val(),
            fg: ifg
        };
         //console.log(idata);
        //console.log(ifg);
        $.ajax({
            url: '@Url.Action("senddt", "InformasiPelapor", null, Request.Url.Scheme)',
            type: 'POST',
            data: idata,
            dataType:"json",
            beforeSend: function (a) {
                $("#id-btnsimpan").prop("disabled", true);
            },
            success: function (a) {
                reloadlogin(a);
                if (a.success) {
                    $('#dataTableIP').DataTable().ajax.reload();
                    $.confirm({
                        title: "Berhasil",
                        content: a.message,
                        type: "green",
                        typeAnimated: true,
                        buttons: {
                            tryAgain: {
                                text: 'OK',
                                btnClass: 'btn-success',
                                action: function () {
                                    //$('#dataTableIP').DataTable().ajax.reload();
                                }
                             }
                         }
                    });
                } else {
                    $.confirm({
                        title: "Gagal",
                        content: "Gagal, " + a.message,
                        type: "red",
                        typeAnimated: true,
                        buttons: {
                            tryAgain: {
                                text: 'OK',
                                btnClass: 'btn-danger',
                                action: function () {
                                }
                            }
                        }
                    });
                }

            },
            complete: function (a) {
                $("#myModal").modal("hide");
                $("#id-btnsimpan").prop("disabled", false);
            }
        });

        return false;
    }

     function dltx() {
         var mdata = { IdPelapor: $("#idpelaporDel").val(), PeriodeLaporan: $("#dd_periodeLap").val().join(',') }
         //console.log(mdata)
         $.ajax({
            type: 'POST',
            url: '@Url.Action("deldt", "InformasiPelapor", null, Request.Url.Scheme)',
            data: mdata,
            dataType: "json",
            beforeSend: function (a) {
                $(".delete").prop("disabled", true);
                $("#myModalConfirm").modal("hide");
            },
            success: function (a) {
                reloadlogin(a);
                 $(".delete").prop("disabled", false);
                 //console.log(a);
                if (a.success) {
                    $('#dataTableIP').DataTable().ajax.reload();
                    $.confirm({
                        title: "Berhasil",
                        content: a.message,
                        type: "green",
                        typeAnimated: true,
                        buttons: {
                            tryAgain: {
                                text: 'OK',
                                btnClass: 'btn-success',
                                action: function () {
                                }
                            }
                        }
                    });
                } else {
                    $.alert({
                        title: 'Peringatan',
                        icon: 'fas fa-warning',
                        type: 'red',
                        content: a.message
                    });
                }

            },
            complete: function (a) {
            }
        });
    }

