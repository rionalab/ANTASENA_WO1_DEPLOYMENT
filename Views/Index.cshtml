    function get_status(a,b,cek) {
        $.ajax({
            type: 'POST',
            url: '@Url.Action("get_status", "InformasiPelapor", null, Request.Url.Scheme)?idpelapor=' + a + '&statuskantor=' + b + '&cek=' + cek,
            dataType:'JSON',
            success: function (e) {
                reloadlogin(e);

                var data = e.data;
                var html = "";
                if (cek == "new") {
                    html = '<option value="" selected>-- Pilih Status Kantor --</option>';
                } else {
                    html = '<option value="">-- Pilih Status Kantor --</option>';
                }
                for (var i = 0; i < data.length; i++) {
                    if (cek == "new") {
                        html = html + '<option value="' + data[i].statuskantor + '" >' + data[i].statuskantor + '</option>';
                    }
                    else {
            
                        html = html + '<option value="' + data[i].statuskantor + '" selected>' + data[i].statuskantor + '</option>';
                    }
                    //html += '<option value="' + data[i].statuskantor + '" ';
                    //if(cek=="new") html += 'selected';
                    //html += ' > ' + data[i].statuskantor + '</option > ';
                  
                }
                //$("#dd_Instansi").multipleSelect('destroy');
                //$("#dd_Instansi").html(html).multipleSelect({
                //    filter: true
                //}).multipleSelect('enable');
                if (cek == "new") {
                    $("#dd_status").html(html).select2("destroy").select2();
                    $("#dd_status").html(html);
                }
                else {
                    $("#dd_status").html(html).select2("destroy").select2();
                }
            },
            complete: function (ee) {
                //if (a != "") {
                //    pop_edit(a,b);
                //}
                $("#dd_status").prop("disabled", false);
            }
        });
    }

