    function get_idpelapor() {
        var mdata = { bank: $("#dd_bank").val(), sk: $("#dd_status").val() };
        $.ajax({
            type: 'POST',
            url: '@Url.Action("get_idpelapor", "InformasiPelapor", null, Request.Url.Scheme)',
            data: mdata,
            dataType: 'JSON',
            beforeSend: function (a) {
                $("#dd_idpelapor").multipleSelect('destroy');
                $("#dd_idpelapor").multipleSelect({
                    placeholder: "<i class='fas fa-spinner fa-spin'></i> Memuat Id Pelapor ..."
                }).multipleSelect('disable');
            },
            success: function (e) {
                reloadlogin(e);
                var data = e.data;
                var html = "";

                var gr_old = "", gr_new = "";
                for (var i = 0; i < data.length; i++) {
                    //optgroup
                    gr_new = data[i].gr;
                    if (gr_new != gr_old) {
                        html = html + '<optgroup label="' + data[i].gr+'">';
                    }
                    html = html + '<option value="' + data[i].id + '">' + data[i].desc + '</option>';

                    if (gr_new != data[((data.length - 1 == i) ? i : i + 1)].gr || (data.length - 1) == i) {
                        html = html + '</optgroup>';
                    }
                    gr_old = data[i].gr;
                }

                $("#dd_idpelapor").multipleSelect('destroy');
                $("#dd_idpelapor").html(html).multipleSelect({
                    filter: true,
                    //minimumCountSelected: 3
                }).multipleSelect('enable');
            },
            complete: function (ee) {
              
            }
        });
    }
</script>

<script>
    var _customizeExcelOptions = function (xlsx) {
        var sheet = xlsx.xl.worksheets['sheet1.xml'];
        var numrows = 1;
        var clR = $('row', sheet);

        //update Row
        clR.each(function () {
            //console.log("ini", $(this));
            var attr = $(this).attr('r');
            var ind = parseInt(attr);
            ind = ind + numrows;
            $(this).attr("r", ind);
        });
    }
