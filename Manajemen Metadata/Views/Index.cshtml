@Scripts.Render("~/bundles/ckeditor")
<script>
    var isvalid = true;
    $(document).ready(function () {
        $.fn.dataTable.moment('DD-MM-YYYY HH:mm:ss');

        //$("#MainTable").DataTable();
        //renderList();

//-- start metadata management --
        var tbl;
        GetListInfoMM();
        $("#GetListInfoMM").select({
            placeholder: "Please Select",
            allowClear: true,
            width: '100%'
        });
        $("#VersionCodeList").select({
            placeholder: "Please Select",
            allowClear: true,
            width: '100%'
        });
        $('#GetListInfoMM').on('change', function () {
            console.log(this.value);
            VersionCodeList();
        });

        document.getElementById("tglAwal").onkeypress = stopRKey;
        document.getElementById("tglAkhir").onkeypress = stopRKey;
//-- end metadatamanagement --


        $("#btnTambah").on("click", function () {
            $("#flxtablehd").html('<input required type="file" class="flxfile form-control " id="flx0" name="flx0" pattern=".*\S+.*" oninvalid="setCustomValidity(\'Field ini harus diisi!\')" oninput="try { setCustomValidity(\'\') } catch (e) { }" /><a href="#" id="clear" class="btn btn-link btn-sm pull-right" onclick="bersihfile(this)">Bersihkan Lampiran</a></div>');
            $("#flxexist").empty();
            $(".mdshow").html("Tambah Lampiran");
            $("#isedit").val(0);
            $("#formInputUsr")[0].reset();
            $("#flxbody").empty();
            $("#myModalAdd").modal("show");
            var today = new Date();
            var dd = String(today.getDate()).padStart(2, '0');
            var mm = String(today.getMonth() + 1).padStart(2, '0');
            var yyyy = today.getFullYear();

            today = dd + '-' + mm + '-' + yyyy;
            $("#TanggalUpload").val(today);
            $("#TanggalUpload").prop("disabled", true);
        });
        $("#flxtable").on("click", "#DeleteButton", function () {
            $(this).closest("tr").remove();
        });

        $("#formInputUsr").submit(function (e) {
            var x = $("#isedit").val();
            var flxfg = $(this).find(".flxfg");



            if (x == 0) {
                if (checkname()) {
                    senddt(this);
                }
                else {
                    $.alert("Judul dan Version sudah ada, mohon pilih judul lain !")
                }
            } else {

                if (flxfg.length >= 1) {
                    if (checknamelama()) {

                        senddt(this);
                    } else {
                        $.alert("Judul dan Version sudah ada, mohon pilih judul lain !")
                    }
                }
                else {
                    $.alert("Mohon pilih minimal 1 file !")
                }
            }


            e.preventDefault();
        })

        $("#flxtable").on("change", "input.flxfile", function (e) {
            var data = e.target.files;
            var id = this.id;
            var a = "";
            var total = 0;
            for (var i = 0; i < data.length; i++) {
                var file = data[i];
                var countsize = file.size;

                if (i != data[i].length - 1) {
                    total += countsize + "+";
                } else {
                    total += countsize;
                }



                const blob = file.slice(0, 4);
                const filereader = new FileReader();

                filereader.onloadend = function (evt) {
                    if (evt.target.readyState === FileReader.DONE) {
                        const uint = new Uint8Array(evt.target.result)
                        let bytes = []
                        uint.forEach((byte) => {
                            bytes.push(byte.toString(16))
                        });
                        const hex = bytes.join('').toUpperCase();
                        if (a == "") {
                            if (
                                file.type == "application/vnd.msexcel" || file.type == "application/zip" ||
                                file.type == "application/pdf" || file.type == "application/msword" ||
                                file.type == "application/vnd.ms-excel" || file.type == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" ||
                                file.type == "application/vnd.openxmlformats-officedocument.wordprocessingml.document" ||
                                file.type == "application/zip" || file.type == "application/x-rar-compressed" || file.type == "application/x-zip-compressed" || file.type == "application/octet-stream" || file.type == "" ) {

                                var fnnam = String(file.name).split(".");
                                var xnnam = String(fnnam[fnnam.length - 1]);
                                //var allw = ['xls', 'xlsx', 'txt', 'jpg', 'csv','doc','docx','pdf','png','jpeg','zip','rar','xml']
                                //var allw = ['text', 'txt', 'xls', 'zip', 'xslt', 'xbl', 'xsl', 'xml', 'pdf', 'doc', 'jfif', 'pjpeg', 'jpeg', 'pjp', 'jpg', 'png', 'xlsx', 'docx', 'rar', 'json', 'csv', 'pptx', 'ppt']
                                var allw = ['zip','rar','pdf','xls','xlsx','doc','docx']
                                if (allw.includes(xnnam)) {


                                    if (getAllowMimetype(hex) == '') {
                                        a += "Tipe file tidak dapat diunggah";
                                        $.alert({
                                            title: 'Peringatan',
                                            type: 'red',
                                            content: 'Tipe file tidak dapat diunggah',
                                            buttons: {
                                                ok: {
                                                    btnClass: 'btn-red',
                                                    action: function () {
                                                        $("#" + id).replaceWith($("#" + id).val('').clone(true));
                                                    }
                                                }
                                            }
                                        });
                                    } else {

                                        var hasil = 0;
                                        var gabungan = total.split("+");

                                        for (var i = 0; i < gabungan.length; i++) {
                                            hasil += gabungan[i] << 0;
                                        }
                                        if (hasil > 53886080) {
                                            a += "Tipe file tidak dapat diunggah";
                                            $("#counterparam").val("0")
                                            $.alert({
                                                title: 'Peringatan',
                                                type: 'red',
                                                content: 'File Yang diUpload Melebihi Dari 50 MB',
                                                buttons: {
                                                    ok: {
                                                        btnClass: 'btn-red',
                                                        action: function () {
                                                            $("#" + id).replaceWith($("#" + id).val('').clone(true));
                                                            $("#counterparam").val("0")
                                                        }
                                                    }
                                                }
                                            });

                                        }
                                    }

                                }
                                else {
                                    a += "Tipe file tidak dapat diunggah";
                                    $.alert({
                                        title: 'Peringatan',
                                        type: 'red',
                                        content: 'Tipe file tidak dapat diunggah',
                                        buttons: {
                                            ok: {
                                                btnClass: 'btn-red',
                                                action: function () {
                                                    $("#" + id).replaceWith($("#" + id).val('').clone(true));
                                                }
                                            }
                                        }
                                    });
                                }
                            } else {
                                a += "Tipe file tidak dapat diunggah";
                                $.alert({
                                    title: 'Peringatan',
                                    type: 'red',
                                    content: 'Tipe File tidak dapat diunggah',
                                    buttons: {
                                        ok: {
                                            btnClass: 'btn-red',
                                            action: function () {
                                                $("#" + id).replaceWith($("#" + id).val('').clone(true));
                                            }
                                        }
                                    }
                                });
                            }
                        }
                        else {
                            return false;
                        }

                    }
                }
                if (a != "") { return false; }
                filereader.readAsArrayBuffer(blob);


            }
        });

        $("#MainTable").on("click", "button.view", function () {
            $("#formInputUsr")[0].reset();
            $("#flxbody").empty();
        });
        $("#MainTable2").on("click", "button.show", function () {
            $("#show_flxexist,#show_LampiranName,#show_LampiranDesc").empty()
            getdetailshow(this.id)
        });

        $("#MainTable").on("click", "button.delete", function () {
            var idtm = this.id;
            $.confirm({
                title: 'Konfirmasi !',
                content: 'Apakah anda yakin ingin menghapus data <b>' + this.value + '</b> ?',
                type: 'red',
                typeAnimated: true,
                buttons: {

                    tutup: function () {
                    },
                    tryAgain: {
                        text: 'Hapus',
                        btnClass: 'btn-red',
                        action: function () {
                            dltx(idtm);
                        }
                    }
                }
            });
        });
        $("#MainTable").on("click", "button.edit", function () {
            $(".mdshow").html("Edit Lampiran");
            $("#flxtablehd").empty();
            $("#isedit").val(1);
            $("#formInputUsr")[0].reset();
            $("#flxbody").empty();
            var today = new Date();
            var dd = String(today.getDate()).padStart(2, '0');
            var mm = String(today.getMonth() + 1).padStart(2, '0');
            var yyyy = today.getFullYear();

            today = dd + '-' + mm + '-' + yyyy;
            $("#TanggalUpload").val(today);
            $("#TanggalUpload").prop("disabled", true);
            getdetail(this.id);
        });

    });

    var fgClick = 0;
    function fmSubmit() {
        var fgFm = true;
        var ListFm = document.forms["formInputUsr"].getElementsByTagName("input");
        for (var i = 0; i < ListFm.length; i++) {
            if (ListFm[i].required) {
                if ($("#" + ListFm[i].id).val().trim() == "") {
                    fgFm = false;
                } else {
                    fgFm = (fgFm) ? true : false;
                }
            }
        }
        setTimeout(function () {
            //console.log("valid", isvalid, "fg", fgFm, "click", fgClick);
            if (!isvalid || !fgFm) {
                if (fgClick == 0) {
                    fmSubmit();
                    fgClick++;
                } else {
                    fgClick = 0;
                }
            }
            else {
                isvalid = true;
            }
            $('#submitForm_').trigger('click');
        }, 1);
    }


