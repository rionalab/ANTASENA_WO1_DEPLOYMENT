    function getMimetype(signature) {


        if (signature.match('4D5A90030004000FFFF00B80000000400000000000000000000000000000000000080000E1FBAE0B49CD21B814CCD21546869732070726F6772616D2063616E6E6F742062652072756E20696E20444F53206D6F64652EDDA')) {
            return 'EXE FILE'
        } else if (signature.match('52494646E86940415649204C495354C00006864726C61766968380009B6F005E74100000108006E000000010002C000100F000000000000000000004C495354740007374726C737472683800076696473637669640000')) {
            return 'AVI FILE'
        }
        else if (signature.match('D0CF11E0A1B11AE100000000000000003E040FEFFC06000000030006000100000000100020001000FEFFFFFF00000000040008000C000100001400FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF')) {
            return 'MSI file'
        } else if (signature.match('4944333000006654434F4E000A00043696E656D6174696354414C4200016000596F755475626520417564696F204C6962726172795449543200010000496D70616374204D6F64657261746F54504531000E0004B6576696E204D61634C656F64FFFBC840000')) {
            return 'MP3 file'
        }
        else if (signature.match('504B34A00000149D7C4A00000000000090004D4554412D494E462F504B34A00080139D7C4A1925CF166A00081000140004D4554412D494E462F4D414E49464553542E4D46F34DCCCB4C4B2D2ED1D4B2D2ACECCCFB35230D433E0E5722ACDCC29D175AA')) {
            return 'JAR File'
            //} else if (signature.match('4A415243')) {
            //    return 'JAR file'
        } else if (signature.match('4D5343460000C5580000004400000003110304000001400000100C5580038180000000000BE000301028CC00000000DB48DA2A2005072696E74436F6E74726F6C5F7265735F74682E646C6C028340028CC0000DB48')) {
            return 'CAB File'
            //} else if (signature.match('4D534346')) {
            //    return 'CAB File'
        }
        else if (signature.match('01005374616E646172642041434520444202000B56E362609C255E9A96772403F09C7E9F90FF859A31C579BAED30BCDFCC9D63D9E4C39F46FB8ABC4E7751EC37ACEE9CFA37F428E6E21C8A60A53E7B364D8DFB1865E13433E5B133C5CB795B631F7C2AA3E07C9981F98FD23A61B315F60')) {
            return 'Access File'

        } else if (signature.match('EFBBBF7573696E672053797374656D3BDA7573696E672053797374656D2E436F6C6C656374696F6E732E47656E657269633BDA7573696E672053797374656D2E4C696E713BDA7573696E672053797374656D2E5765623BDADA6E616D65737061636520416E746173656E612E4D6F64656C73D')) {
            return 'CLASS File'
        } else {
            return ''
        }
    }

    const getAllowMimetype = (signature) => {
        if (signature.match('25504446')) {
            return 'PDF FILE'
        } else if (signature.match('504B0304')) {
            return 'ZIP FILE'
        } else if (signature.match('504B4C49')) {
            return 'ZIP FILE'
        } else if (signature.match('57696E5A')) {
            return 'ZIP file'
        } else if (signature.match('52617221')) {
            return 'RAR file'
        } else if (signature.match('D0CF11E0')) {
            return 'DOC File'
        } else if (signature.match('504B34')) {
            return 'XLSX File'
        //} else if (signature.match('504B0506')) {
        //    return 'DOCX File_jdbc'
        //} else if (signature.match('D0CF11E0A1B11AE1')) {
        //    return 'DOCX File_jdbc2'
        } else {
            return ''
        }
    }

