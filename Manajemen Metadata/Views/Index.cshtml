<div class="modal" id="myModalAdd">
    <div class="modal-dialog modal-lg">

        <form id="formInputUsr">
            <div class="modal-content">
                <input type="hidden" name="isedit" id="isedit" />
                <div class="modal-header">
                    <h4 class="modal-title mdl mdshow">Tambah Lampiran</h4>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">

                    <div class="form-horizontal">
                        <input type="hidden" id="counterparam" name="counterparam" />
                        <div class="form-group row">
                            <label class="col-sm-4 control-label">Judul<span style="color:red"> *</span></label>
                            <div class="col-sm-8">
                                <input required type="text" class="form-control" id="LampiranName" name="LampiranName" maxlength="100" pattern=".*\S+.*" oninvalid="try { (this.value == '') ? setCustomValidity('Field ini harus diisi!') : setCustomValidity(''); isvalid = (this.value == '') ? false : true; } catch (e) { }" oninput="try { setCustomValidity('')} catch (e) { }">
                                <input type="hidden" name="LampiranNameLama" id="LampiranNameLama" />
                                <input type="hidden" name="LampiranId" id="LampiranId" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-4 control-label">Tanggal Upload<span style="color:red"> *</span></label>
                            <div class="col-sm-8">
                                <input required type="text" name="TanggalUpload" id="TanggalUpload" class="form-control" oninvalid="try { (this.value == '') ? setCustomValidity('Field ini harus diisi!') : setCustomValidity(''); isvalid = (this.value == '') ? false : true; } catch (e) { }" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-4 control-label">Version<span style="color:red"> *</span></label>
                            <div class="col-sm-8">
                                <input required type="text" name="Version" id="Version" class="form-control" maxlength="100" pattern=".*\S+.*" oninvalid="try { (this.value == '') ? setCustomValidity('Field ini harus diisi!') : setCustomValidity(''); isvalid = (this.value == '') ? false : true; } catch (e) { }" oninput="try { setCustomValidity('') } catch (e) { }" />
                                <input type="hidden" name="VersionLama" id="VersionLama" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-4 control-label">Deskripsi<span style="color:red"> *</span></label>
                            <div class="col-sm-8">
                                <textarea required class="form-control" id="LampiranDesc" name="LampiranDesc" pattern=".*\S+.*" oninvalid="try { (this.value == '') ? setCustomValidity('Field ini harus diisi!') : setCustomValidity(''); isvalid = (this.value == '') ? false : true; } catch (e) { }" oninput="try { setCustomValidity('') } catch (e) { }"></textarea>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-4 control-label">Aktif</label>
                            <div class="col-sm-8">
                                <input type="checkbox" name="LampiranFgActive" id="LampiranFgActive" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-4 control-label">Pilih File<span style="color:red"> *</span></label>
                            <div class="col-sm-8">
                                <div id="flxexist" style="max-height:200px; overflow-y:auto;margin-bottom:10px;">


                                </div>
                                <table width="100%" id="flxtable">
                                    <thead>
                                        <tr>
                                            <td><div id="flxtablehd"><input required type="file" class="flxfile form-control " id="flx0" name="flx0" pattern=".*\S+.*" oninvalid="try { (this.value == '') ? setCustomValidity('Field ini harus diisi!') : setCustomValidity(''); isvalid = (this.value == '') ? false : true; } catch (e) { }" oninput="try { setCustomValidity('') } catch (e) { }" /><a href="#" id="clear" class="btn btn-link btn-sm pull-right" onclick="bersihfile(this)">Bersihkan Lampiran</a></div></td>
                                            <td></td>
                                        </tr>
                                    </thead>
                                    <tbody id="flxbody"></tbody>
                                    <tfoot>
                                        <tr>
                                            <td colspan="2" align="center" valign="middle"><button type="button" id="btnaddfiles" onclick="addFiles()" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Tambah File</button></td>
                                        </tr>
                                    </tfoot>
                                </table>

                            </div>
                        </div>


                        <div class="form-group row">
                            <label class="col-sm-4 control-label"></label>
                            <div class="col-sm-6">

                            </div>
                        </div>



                    </div>
                </div>

                <!-- Modal footer -->
                <div class="modal-footer">
                    <button class="btn btn-default" id="btnClose" data-dismiss="modal">Tutup</button>

                    @*tambah ini untuk trustee button*@
                    @{
                        var xs = true;
                        foreach (var item in ViewBag.ButtonAcc)
                        {
                            if (item.MenuDesc == "Button New" || item.MenuDesc == "Button Update")
                            {
                                if (xs)
                                {
                                    <button type="button" id="submitForm" onclick="fmSubmit()" class="btn btn-primary">Simpan</button>
                                    <button type="submit" id="submitForm_" class="" hidden></button>
                                }
                                xs = false;

                            }
                        }
                    }
                    @*tambah ini untuk trustee button*@

                </div>

            </div>
        </form>

    </div>

</div>

