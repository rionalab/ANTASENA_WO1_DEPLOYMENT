<div class="modal" id="myModal">
    <div class="modal-dialog modal-lg">
        <form id="formInputTP">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header">
                    <h4 class="modal-title"></h4>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>

                <!-- Modal body -->
                <div class="modal-body">

                    <div class="form-horizontal">
                        <input type="hidden" id="PeriodId" value="0" />
                        <div class="form-group row">
                            <label class="col-sm-4 control-label text-right">Nama Periode<span style="color:red"> *</span></label>
                            <div class="col-sm-6">
                                <input type="text" class="form-control" id="PeriodName" autocomplete="off" name="PeriodName" required pattern=".*\S+.*" oninvalid="(this.value!='')?setCustomValidity('Field ini harus diisi!'):''" oninput="try { (this.value=='')?setCustomValidity('Field ini harus diisi!') :setCustomValidity(''); } catch (e) { }">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-sm-4 control-label text-right">Periode Pelaporan<span style="color:red"> *</span></label>
                            <div class="col-sm-6">
                                <select required class="form-control" id="PeriodType" name="PeriodType" onchange="tipePeriodeChange()">
                                    <option value="Harian">Harian</option>
                                    <option value="Mingguan">Mingguan</option>
                                    <option value="Bulanan">Bulanan</option>
                                    <option value="Triwulanan">Triwulanan</option>
                                    <option value="Semesteran">Semesteran</option>
                                    <option value="Tahunan">Tahunan</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-sm-4 control-label text-right">Waktu Laporan<span style="color:red"> *</span></label>
                            <div class="col-sm-6">
                                <select required class="form-control" id="ddfgmove">
                                    <option value="B">Mundur</option>
                                    <option value="F">Maju</option>
                                    <option value="S">Tetap</option>
                                </select>
                            </div>
                        </div>
                        @*<div id="jnsHari" style="display:none">
                                <div class="form-group row">
                                    <label class="col-sm-4 control-label text-right">Jenis Hari<span style="color:red"> *</span></label>
                                    <div class="col-sm-6">
                                        <select class="form-control" id="ddJenisHari">
                                            <option value="W">Hari Kerja</option>
                                            <option value="C">Hari Kalender</option>
                                        </select>
                                    </div>
                                </div>
                            </div>*@

                        <div id="tblharian">
                            <div class="form-group row">
                                <label class="col-sm-4 control-label text-right">Tipe Hari<span style="color:red"> *</span></label>
                                <div class="col-sm-6">
                                    <select required class="form-control" id="ddHtipeharian" name="ddHtipeharian">
                                        <option value="D">Harian Normal</option>
                                        <option value="D1">Harian PUAB Pagi</option>
                                        <option value="D2">Harian PUAB Sore</option>
                                        <option value="D3">Harian PUAB Valas</option>
                                        <option value="D4">Harian PUAB LN</option>
                                        <option value="D5">Harian PUAS/DOC</option>
                                        <option value="D6">Harian JIBOR</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-sm-4 control-label text-right">Periode Penyampaian<span style="color:red"> *</span></label>
                                <div class="col-sm-8">
                                    <div class="input-group">
                                        <label class="col-sm-5 text-right">Jumlah Hari Kerja Pelaporan</label>
                                        <select id="JumlahHariPelaporan" class="form-control col-sm-4"></select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-sm-4 control-label text-right"></label>
                                <div class="col-sm-8">
                                    <div class="input-group">
                                        <label class="col-sm-5 text-right">Jam Buka</label>
                                        <input required type="text" class="form-control col-sm-4" autocomplete="off" id="txtJamBukaPelaporan" style="width:60px" placeholder="--:--:--" onkeypress="return isNumber(event,this)">
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-sm-4 control-label text-right"></label>
                                <div class="col-sm-8">
                                    @*<div class="col-sm-4">*@
                                    <div class="input-group">
                                        <label class="col-sm-5 text-right">Jam Tutup</label>
                                        @*<input required type="time" class="form-control col-sm-4" id="txtJamTutupPelaporan" style="width:60px" step="2">*@
                                        <input required type="text" class="form-control col-sm-4" autocomplete="off" id="txtJamTutupPelaporan" placeholder="--:--:--" style="width:60px" onkeypress="return isNumber(event,this)">
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-sm-4 control-label text-right"><input type="checkbox" id="cb_usekoreksi" onchange="cbPeriodeKoreksi()" /> Periode Koreksi</label>
                            </div>
                            <div class="form-group row">
                                <div class="col-sm-2"></div>
                                <div class="col-sm-2">
                                    <select class="form-control" id="ddHKoreksi" disabled></select>
                                </div>
                                <div class="col-sm-4">
                                    <div class="input-group">
                                        <label class="col-sm-5 text-right">Jam Buka</label>
                                        @*<input type="time" class="form-control" id="txtJamBukaKoreksi" step="2" style="width:60px" disabled>*@
                                        <input type="text" class="form-control" id="txtJamBukaKoreksi" placeholder="--:--:--" style="width:60px" onkeypress="return isNumber(event,this)" disabled>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="input-group">
                                        <label class="col-sm-5 text-right">Jam Tutup</label>
                                        @*<input type="time" class="form-control" id="txtJamTutupKoreksi" step="2" style="width:60px" disabled>*@
                                        <input type="text" class="form-control" id="txtJamTutupKoreksi" placeholder="--:--:--" style="width:60px" onkeypress="return isNumber(event,this)" disabled>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div id="tblmingguan" style="display:none">
                            <div>
                                <div class="form-group row">
                                    <label class="col-sm-12 control-label">Periode Penyampaian</label>
                                </div>
                                <div class="form-group row">
                                    <label class="col-sm-2 control-label text-right">Minggu 1</label>
                                    <label class="col-sm-1 control-label text-right">Mulai</label>
                                    <div class="col-sm-2">
                                        <select class="form-control" id="ddPP_MonthM1"></select>
                                    </div>
                                    <label class="col-sm-1 control-label text-right">Akhir</label>
                                    <div class="col-sm-2">
                                        <select class="form-control" id="ddPP_MonthA1"></select>
                                    </div>

                                </div>
                                <div class="form-group row">
                                    <label class="col-sm-2 control-label text-right">Minggu 2</label>
                                    <label class="col-sm-1 control-label text-right">Mulai</label>
                                    <div class="col-sm-2">
                                        <select class="form-control" id="ddPP_MonthM2"></select>
                                    </div>
                                    <label class="col-sm-1 control-label text-right">Akhir</label>
                                    <div class="col-sm-2">
                                        <select class="form-control" id="ddPP_MonthA2"></select>
                                    </div>
                                    <label class="col-sm-1 control-label text-right">Periode Data</label>
                                    <div class="col-sm-2">
                                        <select class="form-control" id="ddPP_MonthPD2"></select>
                                    </div>

                                </div>
                                <div class="form-group row">
                                    <label class="col-sm-2 control-label text-right">Minggu 3</label>
                                    <label class="col-sm-1 control-label text-right">Mulai</label>
                                    <div class="col-sm-2">
                                        <select class="form-control" id="ddPP_MonthM3"></select>
                                    </div>
                                    <label class="col-sm-1 control-label text-right">Akhir</label>
                                    <div class="col-sm-2">
                                        <select class="form-control" id="ddPP_MonthA3"></select>
                                    </div>
                                    <label class="col-sm-1 control-label text-right">Periode Data</label>
                                    <div class="col-sm-2">
                                        <select class="form-control" id="ddPP_MonthPD3"></select>
                                    </div>

                                </div>
                                <div class="form-group row">
                                    <label class="col-sm-2 control-label text-right">Minggu 4</label>
                                    <label class="col-sm-1 control-label text-right">Mulai</label>
                                    <div class="col-sm-2">
                                        <select class="form-control" id="ddPP_MonthM4"></select>
                                    </div>
                                    <label class="col-sm-1 control-label text-right">Akhir</label>
                                    <div class="col-sm-2">
                                        <select class="form-control" id="ddPP_MonthA4"></select>
                                    </div>
                                    <label class="col-sm-1 control-label text-right">Periode Data</label>
                                    <div class="col-sm-2">
                                        <select class="form-control" id="ddPP_MonthPD4"></select>
                                    </div>

                                </div>
                            </div>
                            <div>
                                <div class="form-group row">
                                    <label class="col-sm-4 control-label text-right">Periode Keterlambatan<span style="color:red"> *</span></label>
                                    <div class="col-sm-2">
                                        <input type="number" min="0" class="form-control" id="txtPeriodeTerlambat" required pattern=".*\S+.*" oninvalid="(this.value!='')?setCustomValidity('Field ini harus diisi!'):''" oninput="try { (this.value=='')?setCustomValidity('Field ini harus diisi!') :setCustomValidity(''); } catch (e) { }">
                                    </div>
                                    <div class="col-sm-6">hari</div>
                                </div>
                            </div>

                        </div>

                        <div id="tblbulanan" style="display:none">
                            <div class="form-group row">
                                <label class="col-sm-4 control-label">Periode Penyampaian</label>
                                <label class="col-sm-1 control-label text-right">Mulai</label>
                                <div class="col-sm-2">
                                    <select class="form-control" id="ddBPPMulai"></select>
                                </div>
                                <label class="col-sm-1 control-label text-right">Akhir</label>
                                <div class="col-sm-2">
                                    <select class="form-control" id="ddBPPAkhir"></select>
                                </div>

                            </div>
                            <div class="form-group row">
                                <label class="col-sm-4 control-label text-right">Periode Keterlambatan<span style="color:red"> *</span></label>
                                <div class="col-sm-2">
                                    <input type="number" min="0" class="form-control" id="txtBPeriodeTerlambat" required pattern=".*\S+.*" oninvalid="(this.value!='')?setCustomValidity('Field ini harus diisi!'):''" oninput="try { (this.value=='')?setCustomValidity('Field ini harus diisi!') :setCustomValidity(''); } catch (e) { }">
                                </div>
                                <div class="col-sm-6">hari</div>
                            </div>

                        </div>

                        <div id="tbltriwulan" style="display:none">
                            <div class="form-group row">
                                <label class="col-sm-4 control-label">Periode Penyampaian</label>
                            </div>
                            <div class="form-group row">
                                <label class="col-sm-2 control-label text-right">Triwulan 1 (Januari)</label>
                                <label class="col-sm-2 control-label text-right">Mulai</label>
                                <div class="col-sm-2">
                                    <select class="form-control" id="ddT1Mulai"></select>
                                </div>
                                <label class="col-sm-2 control-label text-right">Akhir</label>
                                <div class="col-sm-2">
                                    <select class="form-control" id="ddT1Akhir"></select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-sm-2 control-label text-right">Triwulan 2 (April)</label>
                                <label class="col-sm-2 control-label text-right">Mulai</label>
                                <div class="col-sm-2">
                                    <select class="form-control" id="ddT2Mulai"></select>
                                </div>
                                <label class="col-sm-2 control-label text-right">Akhir</label>
                                <div class="col-sm-2">
                                    <select class="form-control" id="ddT2Akhir"></select>
                                </div>

                            </div>
                            <div class="form-group row">
                                <label class="col-sm-2 control-label text-right">Triwulan 3 (Juli)</label>
                                <label class="col-sm-2 control-label text-right">Mulai</label>
                                <div class="col-sm-2">
                                    <select class="form-control" id="ddT3Mulai"></select>
                                </div>
                                <label class="col-sm-2 control-label text-right">Akhir</label>
                                <div class="col-sm-2">
                                    <select class="form-control" id="ddT3Akhir"></select>
                                </div>

                            </div>
                            <div class="form-group row">
                                <label class="col-sm-2 control-label text-right">Triwulan 4 (Oktober)</label>
                                <label class="col-sm-2 control-label text-right">Mulai</label>
                                <div class="col-sm-2">
                                    <select class="form-control" id="ddT4Mulai"></select>
                                </div>
                                <label class="col-sm-2 control-label text-right">Akhir</label>
                                <div class="col-sm-2">
                                    <select class="form-control" id="ddT4Akhir"></select>
                                </div>

                            </div>
                            <div class="form-group row">
                                <label class="col-sm-4 control-label text-right">Periode Keterlambatan<span style="color:red"> *</span></label>
                                <div class="col-sm-2">
                                    <input type="number" min="0" class="form-control" id="txtTPeriodeTerlambat" required pattern=".*\S+.*" oninvalid="(this.value!='')?setCustomValidity('Field ini harus diisi!'):''" oninput="try { (this.value=='')?setCustomValidity('Field ini harus diisi!') :setCustomValidity(''); } catch (e) { }">
                                </div>
                                <div class="col-sm-6">hari</div>
                            </div>

                        </div>

                        <div id="tblsemesteran" style="display:none">
                            <div class="form-group row">
                                <label class="col-sm-4 control-label">Periode Penyampaian</label>
                            </div>

                            @for (int i = 1; i <= 2; i++)
                            {
                                <div class="form-group row">
                                    <label class="col-sm-2 control-label text-right">Semester @i @(i == 1 ? "(Januari)":"(Juli)")</label>
                                    <label class="col-sm-2 control-label text-right">Mulai</label>
                                    <div class="col-sm-2">
                                        <select class="form-control" id="periodeMulaiFormSemester@(i)"></select>
                                    </div>
                                    <label class="col-sm-2 control-label text-right">Akhir</label>
                                    <div class="col-sm-2">
                                        <select class="form-control" id="periodeAkhirFormSemester@(i)"></select>
                                    </div>
                                </div>
                            }

                            @Html.Raw(inputPeriodeTerlambat)
                        </div>

                        <div id="tbltahunan" style="display:none">
                            <div class="form-group row">
                                <label class="col-sm-4 control-label">Periode Penyampaian</label>
                                <label class="col-sm-1 control-label text-right">Mulai</label>
                                <div class="col-sm-2">
                                    <select class="form-control" id="periodeMulaiFormTahunan"></select>
                                </div>
                                <label class="col-sm-1 control-label text-right">Akhir</label>
                                <div class="col-sm-2">
                                    <select class="form-control" id="periodeAkhirFormTahunan"></select>
                                </div>
                            </div>
                             
                            @Html.Raw(inputPeriodeTerlambat)
                        </div>
                    </div>
                </div>

                <!-- Modal footer -->
                <div class="modal-footer">
                    <button class="btn btn-default" id="btnClose" data-dismiss="modal">Tutup</button>
                    @{
                        var tf = true;
                        foreach (var item in ViewBag.ButtonAcc)
                        {
                            if (item.MenuDesc == "Button New" || item.MenuDesc == "Button Update")
                            {
                                if (tf)
                                {
                                    @*<button type="button" onclick="senddt()" id="submitForm" class="btn btn-primary">Simpan</button>*@
                                    <button type="submit" id="submitForm" class="btn btn-primary">Simpan</button>
                                }
                                tf = false;
                            }
                        }
                    }
                </div>

            </div>
        </form>
    </div>
</div>


