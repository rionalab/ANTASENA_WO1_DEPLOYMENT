<script>
    function fn_Generate() {
        var iTahun_exc = new Date().getFullYear() - 1;
        var iHtml_exc = "";
        for (var i = 0; i < 7; i++) {
            var ithn = iTahun_exc + i;
            iHtml_exc = iHtml_exc + '<option value="' + ithn + '">' + ithn + '</option>';
        }

        $("#periodeData_EX").datepicker({
            changeMonth: true,
            changeYear: true,
            dateFormat: 'dd-mm-yy',
            onSelect: function () {
                var iminDate = $(this).datepicker('getDate');
                $('#tglBuka_EX').datepicker('option', 'minDate', iminDate);
                $('#tglTutup_EX').datepicker('option', 'minDate', iminDate);
            }
        }).datepicker('setDate', new Date());
        $("#tglBuka_EX").datepicker({
            changeMonth: true,
            changeYear: true,
            dateFormat: 'dd-mm-yy',
            onSelect: function () {
                var iminDate = $(this).datepicker('getDate');
                $('#tglTutup_EX').datepicker('option', 'minDate', iminDate);
            }
        });
        $("#tglTutup_EX").datepicker({
            changeMonth: true,
            changeYear: true,
            dateFormat: 'dd-mm-yy',
        });
        $('#periodeData_EX').datepicker('setDate', new Date());
        $('#tglBuka_EX').datepicker('option', 'minDate', new Date());
        $('#tglTutup_EX').datepicker('option', 'minDate', new Date());


        $("#btnperiodeData_EX").click(function () {
            $("#periodeData_EX").datepicker("show");
        });
        $("#btntglBuka_EX").click(function () {
            $("#tglBuka_EX").datepicker("show");
        });
        $("#btntglTutup_EX").click(function () {
            $("#tglTutup_EX").datepicker("show");
        });

        $("#ddMTahun_EX").html(iHtml_exc);
        $("#ddBTahun_EX").html(iHtml_exc);
        $("#ddTTahun_EX").html(iHtml_exc);
        $("#ddSTahun_EX").html(iHtml_exc);
        $("#ddThTahun_EX").html(iHtml_exc);
    }

    function setBulan(e) {
        $("#ddMTambahBulanMulai_EX").html('<option value="0">0</option>' + e);
        $("#ddMTambahBulanAkhir_EX").html('<option value="0">0</option>' + e);
        $("#ddBBulan_EX").html(e);
        $("#ddBTambahBulanAkhir_EX").html('<option value="0">0</option>' + e);
        var htmlTriwulan = '';
        for (var i = 1; i < 5; i++) {
            htmlTriwulan += '<option value="' + i + '">' + i + '</option>';
        }
        $("#ddTBulan_EX").html(htmlTriwulan);
         
        $("#ddSSemester_EX").html(`
            <option value="1">1</option>
            <option value="2">2</option>
        `);
        
        $("#ddTTambahBulanAkhir_EX, #ddSTambahBulanAkhir_EX, #ddThTambahBulanAkhir_EX").html('<option value="0">0</option>' + e);
    }

    function isFailedPeriodePenyampaian_EX() {
        var iPeriodType = $('#PeriodType_EX').val();

        if (iPeriodType == 'Harian') {
            var jamBuka = $('#txtJamBukaPelaporan_EX').val();
            var jamTutup = $('#txtJamTutupPelaporan_EX').val();
            var jamBukaKoreksi = $('#txtJamBukaKoreksi_EX').val();
            var jamTutupKoreksi = $('#txtJamTutupKoreksi_EX').val();
            if (jamBuka == "00:00") jamBuka = "12:00";
            if (jamTutup == "00:00") jamTutup = "12:00";
            if (jamBukaKoreksi == "00:00") jamBukaKoreksi = "12:00";
            if (jamTutupKoreksi == "00:00") jamTutupKoreksi = "12:00";

            $("#txtJamBukaPelaporan_EX").css("background", "white");
            $("#txtJamTutupPelaporan_EX").css("background", "white");
            $("#txtJamBukaKoreksi_EX").css("background", "white");
            $("#txtJamTutupKoreksi_EX").css("background", "white");

            var arrJamBuka = jamBuka.split(':');
            if (jamBuka.length < 8) {
                $("#txtJamBukaPelaporan_EX").css("background", "pink");
                ShowAlertMessage('Mohon periksa jam buka periode penyampaian');
                return true;
            }
            if (jamTutup.length < 8) {
                $("#txtJamTutupPelaporan_EX").css("background", "pink");
                ShowAlertMessage('Mohon periksa jam tutup periode penyampaian');
                return true;
            }

            if (parseInt(arrJamBuka[0]) >= 24 || parseInt(arrJamBuka[1]) >= 60 || parseInt(arrJamBuka[2]) >= 60) {
                $("#txtJamBukaPelaporan_EX").css("background", "pink");
                ShowAlertMessage('Mohon periksa jam buka periode penyampaian');
                return true;
            }
            var arrJamTutup = jamTutup.split(':');
            if (parseInt(arrJamTutup[0]) >= 24 || parseInt(arrJamTutup[1]) >= 60 || parseInt(arrJamTutup[2]) >= 60) {
                $("#txtJamTutupPelaporan_EX").css("background", "pink");
                ShowAlertMessage('Mohon periksa jam tutup periode penyampaian');
                return true;
            }
            var isChkPeriodeKoreksi = document.getElementById('cb_usekoreksi_EX').checked;
            if (isChkPeriodeKoreksi) {
                var arrJamBukaKoreksi = jamBukaKoreksi.split(':');
                if (parseInt(arrJamBukaKoreksi[0]) >= 24 || parseInt(arrJamBukaKoreksi[1]) >= 60 || parseInt(arrJamBukaKoreksi[2]) >= 60) {
                    $("#txtJamBukaKoreksi_EX").css("background", "pink");
                    ShowAlertMessage('Mohon periksa jam buka periode koreksi');
                    return true;
                }
                var arrJamTutupKoreksi = jamTutupKoreksi.split(':');
                if (parseInt(arrJamTutupKoreksi[0]) >= 24 || parseInt(arrJamTutupKoreksi[1]) >= 60 || parseInt(arrJamTutupKoreksi[2]) >= 60) {
                    $("#txtJamTutupKoreksi_EX").css("background", "pink");
                    ShowAlertMessage('Mohon periksa jam tutup periode koreksi');
                    return true;
                }
            }

            if (jamTutup < jamBuka) {
                $("#txtJamBukaPelaporan_EX").css("background", "pink");
                $("#txtJamTutupPelaporan_EX").css("background", "pink");
                var isChkPeriodeKoreksi = document.getElementById('cb_usekoreksi_EX').checked;
                if (isChkPeriodeKoreksi) {
                    if (jamTutupKoreksi < jamBukaKoreksi) {
                        $("#txtJamBukaKoreksi_EX").css("background", "pink");
                        $("#txtJamTutupKoreksi_EX").css("background", "pink");
                        ShowAlertMessage('Mohon periksa jam periode penyampaian dan periode koreksi');
                        return true;
                    }
                    if ($("#ddHKoreksi_EX").val() == "0") {
                        if (jamBukaKoreksi <= jamTutup) {
                            $("#txtJamBukaKoreksi_EX").css("background", "pink");
                            ShowAlertMessage('Mohon periksa jam buka periode koreksi');
                            return true;
                        }
                    }
                }
                ShowAlertMessage('Mohon periksa jam buka dan tutup periode penyampaian');
                return true;
            } else {
                var isChkPeriodeKoreksi = document.getElementById('cb_usekoreksi_EX').checked;
                if (isChkPeriodeKoreksi) {
                    if (jamTutupKoreksi < jamBukaKoreksi) {
                        $("#txtJamBukaKoreksi_EX").css("background", "pink");
                        $("#txtJamTutupKoreksi_EX").css("background", "pink");
                        ShowAlertMessage('Mohon periksa jam periode penyampaian dan periode koreksi');
                        return true;
                    }

                    if ($("#ddHKoreksi_EX").val() == "0") {
                        if (jamBukaKoreksi < jamTutup) {
                            $("#txtJamBukaKoreksi_EX").css("background", "pink");
                            ShowAlertMessage('Jam Buka Koreksi harus lebih dari sama dengan Jam Tutup Pelaporan');
                            return true;
                        }
                    }
                } else {
                    return false;
                }
            }
        } else if (iPeriodType == 'Mingguan') {
            $("#ddMTglAkhir_EX").css("background", "white");
            $("#ddMTglMulai_EX").css("background", "white");
            $("#ddMTambahBulanMulai_EX").css("background", "white");
            $("#ddMTambahBulanAkhir_EX").css("background", "white");
            if (parseInt($("#ddMTambahBulanMulai_EX").val()) > parseInt($("#ddMTambahBulanAkhir_EX").val())) {
                $("#ddMTambahBulanMulai_EX").css("background", "pink");
                $("#ddMTambahBulanAkhir_EX").css("background", "pink");
                ShowAlertMessage('Penambahan bulan awal harus lebih kecil atau sama dengan penambahan bulan akhir');
                return true;
            }
            if (parseInt($("#ddMTambahBulanMulai_EX").val()) == parseInt($("#ddMTambahBulanAkhir_EX").val()) &&
                parseInt($("#ddMTglAkhir_EX").val()) < parseInt($("#ddMTglMulai_EX").val())) {
                $("#ddMTglAkhir_EX").css("background", "pink");
                $("#ddMTglMulai_EX").css("background", "pink");
                ShowAlertMessage('Tanggal akhir periode penyampaian harus lebih dari sama dengan tanggal mulai');
                return true;
            }
            if ($("#ddMTambahBulanMulai_EX").val() == "0" && $("#ddMTambahBulanAkhir_EX").val() == "0") {
                $("#ddTTglMulai_EX").css("background", "white");
                $("#ddTTglAkhir_EX").css("background", "white");
                if (parseInt($("#ddMTglAkhir_EX").val()) < parseInt($("#ddMTglMulai_EX").val())) {
                    $("#ddMTglAkhir_EX").css("background", "pink");
                    $("#ddMTglMulai_EX").css("background", "pink");
                    ShowAlertMessage('Tanggal akhir periode penyampaian harus lebih dari sama dengan tanggal mulai');
                    return true;
                }
            }
        } else if (iPeriodType == 'Bulanan') {
            if ($("#ddBTambahBulanAkhir_EX").val() == "0") {
                $("#ddBTglMulai_EX").css("background", "white");
                $("#ddBTglAkhir_EX").css("background", "white");
                if (parseInt($("#ddBTglAkhir_EX").val()) < parseInt($("#ddBTglMulai_EX").val())) {
                    $("#ddBTglAkhir_EX").css("background", "pink");
                    $("#ddBTglMulai_EX").css("background", "pink");
                    ShowAlertMessage('Tanggal akhir periode penyampaian harus lebih dari sama dengan tanggal mulai');
                    return true;
                }
            }
        } else if (iPeriodType == 'Triwulanan') {
            if ($("#ddTTambahBulanAkhir_EX").val() == "0") {
                $("#ddTTglMulai_EX").css("background", "white");
                $("#ddTTglAkhir_EX").css("background", "white");
                if (parseInt($("#ddTTglAkhir_EX").val()) < parseInt($("#ddTTglMulai_EX").val())) {
                    $("#ddTTglAkhir_EX").css("background", "pink");
                    $("#ddTTglMulai_EX").css("background", "pink");
                    ShowAlertMessage('Tanggal akhir periode penyampaian harus lebih dari sama dengan tanggal mulai');
                    return true;
                }
            }
        } else if (iPeriodType == 'Semesteran') {
            if ($("#ddSTambahBulanAkhir_EX").val() == "0") {
                $("#ddSTglMulai_EX").css("background", "white");
                $("#ddSTglAkhir_EX").css("background", "white");
                if (parseInt($("#ddSTglAkhir_EX").val()) < parseInt($("#ddSTglMulai_EX").val())) {
                    $("#ddSTglAkhir_EX").css("background", "pink");
                    $("#ddSTglMulai_EX").css("background", "pink");
                    ShowAlertMessage('Tanggal akhir periode penyampaian harus lebih dari sama dengan tanggal mulai');
                    return true;
                }
            }
        } else if (iPeriodType == 'Tahunan') {
            if ($("#ddThTambahBulanAkhir_EX").val() == "0") {
                $("#ddThTglMulai_EX").css("background", "white");
                $("#ddThTglAkhir_EX").css("background", "white");
                if (parseInt($("#ddThTglAkhir_EX").val()) < parseInt($("#ddThTglMulai_EX").val())) {
                    $("#ddThTglAkhir_EX").css("background", "pink");
                    $("#ddThTglMulai_EX").css("background", "pink");
                    ShowAlertMessage('Tanggal akhir periode penyampaian harus lebih dari sama dengan tanggal mulai');
                    return true;
                }
            }
        }


    }
</script>