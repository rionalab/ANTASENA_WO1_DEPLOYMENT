    function dd_PeriodeException(defaultPeriode = '') {
        const periodeType = defaultPeriode || $("#PeriodType_EX").val() || '';

        if (periodeType == "") {
            $("#PeriodNameOri_EX").prop("disabled", true);
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("dd_PeriodeException", "TipePeriode", null, Request.Url.Scheme)?PeriodType=' + periodeType,
            dataType:'JSON',
            success: function (e) {
                reloadlogin(e);
                //console.log(e);
                var data = e.data;
                //var ddhtml = '<option value=""></option>';
                var ddhtml = '';
                for (var i = 0; i < data.length; i++) {
                    ddhtml += '<option value="' + data[i].id + '">' + data[i].desc + '</option>';
                }

                if (iPeriodType == "") {
                    $("#PeriodType_EX").html(ddhtml);
                    iPeriodType = "Harian";
                    dd_PeriodeException();
                }
                if (iPeriodType != "") {
                    $("#PeriodNameOri_EX").html(ddhtml);
                }
            },
            complete: function (ee) {
                if (iPeriodType != "") {
                    //$("#PeriodNameOri_EX").select2("val", "");
                    //$("#PeriodNameOri_EX").val("");
                    $("#PeriodNameOri_EX").prop("disabled", false);
                } else {
                    //$("#PeriodType_EX").val(iPeriodType);
                    //$("#PeriodType_EX").select2("val", iPeriodType);
                }

            }
        });
    }

