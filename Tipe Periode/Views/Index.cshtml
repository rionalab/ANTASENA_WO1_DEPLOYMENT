    function parseDateFormat(strDate,delimiter,format) {
        var dateParts = strDate.split(delimiter)
        var dateObject = new Date(+dateParts[2], dateParts[1] - 1, +dateParts[0]);
        return moment(dateObject).format(format);
    }
