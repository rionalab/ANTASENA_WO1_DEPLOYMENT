        Tahunan : document.getElementById("tbltahunan_EX"),
    }

    const   elementsFormDefault=  {
        Harian : document.getElementById("tblharian"),
        Mingguan : document.getElementById("tblmingguan"),
        Bulanan : document.getElementById("tblbulanan"),
        Triwulanan : document.getElementById("tbltriwulan"),
        Semesteran : document.getElementById("tblsemesteran"),
        Tahunan : document.getElementById("tbltahunan"),
    }

    const toggleForm = (modalType, formType) => {
        try { 
            const source  = modalType == "DF" ? elementsFormDefault : elementsFormEx;
            Object.values(source).forEach(el => el.style.display = "none");
            source[formType].style.display = "inline";
            // console.log(modalType, formType, source, source[formType])
        }catch(e) {
            console.log(e)
        }
    }



    $(document).ready(function () {
        //for user firefox: block jika input huruf
        $("#txtBPeriodeTerlambat").on("keypress keyup blur", function (event) {
            $(this).val($(this).val().replace(/[^\d].+/, ""));
            if ((event.which < 48 || event.which > 57)) {
                event.preventDefault();
            }
        });
        $("#txtPeriodeTerlambat").on("keypress keyup blur", function (event) {
            $(this).val($(this).val().replace(/[^\d].+/, ""));
            if ((event.which < 48 || event.which > 57)) {
                event.preventDefault();
            }
        });
        $("#txtTPeriodeTerlambat").on("keypress keyup blur", function (event) {
            $(this).val($(this).val().replace(/[^\d].+/, ""));
            if ((event.which < 48 || event.which > 57)) {
                event.preventDefault();
            }
        });

        var htmlHari = "";
        for (var i = 1; i <= 31; i++) {
            htmlHari = htmlHari + '<option value="' + i + '">' + i +'</option> ';
        }
        var htmlBulan = "";
        for (var i = 1; i < 13; i++) {
            htmlBulan += '<option value="' + i + '">' + i + '</option>';
        }
        setBulan(htmlBulan);
        setHari(htmlHari);

        $("#dataTableTP").on("click", "button.view", function () {
            $("#formInputTP")[0].reset();

            getdetTP(this.id);
        });

        $("#dataTableTP").on("click", "button.delete", function () {
            var i_id = this.id;
            $.confirm({
                title: 'Konfirmasi !',
                content: 'Apakah anda yakin ingin menghapus tipe periode <b>' + this.value + '</b> ?',
                type: 'red',
                typeAnimated: true,
                buttons: {

                    tutup: function () {
                    },
                    tryAgain: {
                        text: 'Hapus',
                        btnClass: 'btn-red',
                        action: function () {
                            dltx(i_id);
                        }
                    }
                }
            });
        })

        $("#btnAdd").on("click", function () {
            $("#PeriodId").val(0);
            $("#formInputTP")[0].reset();
            $(".modal-title").text("Tambah Tipe Periode");
            $("#myModal").modal({
                backdrop: "static",
                keyboard: false
            });

            $("#PeriodName").prop("disabled", false);
            $("#PeriodType").prop("disabled", false);
            $("#ddfgmove").prop("disabled", false);
            tipePeriodeChange();
            setRequired();
        });

        $("#formInputTP").submit(function (e) {
            e.preventDefault();
            if (!isFailedPeriodePenyampaian()) {
                senddt();
            }
        });
    });

    function ShowAlertMessage(msg) {
        $.confirm({
            title: "Perhatian",
            content: msg,
            type: "red",
            typeAnimated: true,
            buttons: {
                tryAgain: {
                    text: 'OK',
                    btnClass: 'btn-danger',
                    action: function () {
                    }
                }
            }
        });
    }

    //Add by Deni : 27 09 2019
    function isFailedPeriodePenyampaian() {
        var periodeLaporan = $('#PeriodType').val();

        if (periodeLaporan == 'Harian') {
            var jamBuka = $('#txtJamBukaPelaporan').val();
            var jamTutup = $('#txtJamTutupPelaporan').val();
            var jamBukaKoreksi = $('#txtJamBukaKoreksi').val();
            var jamTutupKoreksi = $('#txtJamTutupKoreksi').val();
            if (jamBuka == "00:00") jamBuka = "12:00";
            if (jamTutup == "00:00") jamTutup = "12:00";
            if (jamBukaKoreksi == "00:00") jamBukaKoreksi = "12:00";
            if (jamTutupKoreksi == "00:00") jamTutupKoreksi = "12:00";

            var arrJamBuka = jamBuka.split(':');

            if (jamBuka.length < 8 || jamTutup.length < 8)
            {
                ShowAlertMessage('Mohon periksa jam periode penyampaian');
                return true;
            }

            if (parseInt(arrJamBuka[0]) >= 24 || parseInt(arrJamBuka[1]) >= 60 || parseInt(arrJamBuka[2]) >= 60) {
                ShowAlertMessage('Mohon periksa jam periode penyampaian');
                return true;
            }
            var arrJamTutup = jamTutup.split(':');
            if (parseInt(arrJamTutup[0]) >= 24 || parseInt(arrJamTutup[1]) >= 60 || parseInt(arrJamTutup[2]) >= 60) {
                ShowAlertMessage('Mohon periksa jam periode penyampaian');
                return true;
            }
            var isChkPeriodeKoreksi = document.getElementById('cb_usekoreksi').checked;
            if (isChkPeriodeKoreksi) {
                var arrJamBukaKoreksi = jamBukaKoreksi.split(':');
                if (parseInt(arrJamBukaKoreksi[0]) >= 24 || parseInt(arrJamBukaKoreksi[1]) >= 60 || parseInt(arrJamBukaKoreksi[2]) >= 60) {
                    ShowAlertMessage('Mohon periksa jam periode koreksi');
                    return true;
                }
                var arrJamTutupKoreksi = jamTutupKoreksi.split(':');
                if (parseInt(arrJamTutupKoreksi[0]) >= 24 || parseInt(arrJamTutupKoreksi[1]) >= 60 || parseInt(arrJamTutupKoreksi[2]) >= 60) {
                    ShowAlertMessage('Mohon periksa jam periode koreksi');
                    return true;
                }
            }

            if (jamTutup < jamBuka) {
                var isChkPeriodeKoreksi = document.getElementById('cb_usekoreksi').checked;
                if (isChkPeriodeKoreksi) {
                    if (jamTutupKoreksi < jamBukaKoreksi) {
                        ShowAlertMessage('Mohon periksa periode penyampaian dan periode koreksi');
                        return true;
                    } else {
                        ShowAlertMessage('Mohon periksa periode penyampaian');
                        return true;
                    }

                    if ($("#ddHKoreksi").val() == "0") {
                        if (jamBukaKoreksi <= jamTutup) {
                            ShowAlertMessage('Mohon periksa periode koreksi');
                            return true;
                        }
                    }

                } else {
                    ShowAlertMessage('Mohon periksa periode penyampaian');
                    return true;
                }
            } else {
                var isChkPeriodeKoreksi = document.getElementById('cb_usekoreksi').checked;
                if (isChkPeriodeKoreksi) {
                    if (jamTutupKoreksi < jamBukaKoreksi) {
                        ShowAlertMessage('Mohon periksa periode penyampaian dan periode koreksi');
                        return true;
                    }

                    if ($("#ddHKoreksi").val() == "0") {
                        if (jamBukaKoreksi < jamTutup) {
                            ShowAlertMessage('Jam Buka Koreksi harus lebih dari sama dengan Jam Tutup Pelaporan');
