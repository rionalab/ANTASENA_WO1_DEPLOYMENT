            var triwulanAkhir_3 = parseInt($('#ddT3Akhir').val());

            var triwulanMulai_4 = parseInt($('#ddT4Mulai').val());
            var triwulanAkhir_4 = parseInt($('#ddT4Akhir').val());

            if (triwulanAkhir_1 < triwulanMulai_1) {
                ShowAlertMessage('Mohon periksa periode penyampaian');
                return true;
            }
            if (triwulanAkhir_2 < triwulanMulai_2) {
                ShowAlertMessage('Mohon periksa periode penyampaian');
                return true;
            }
      
            if (triwulanAkhir_3 < triwulanMulai_3) {
                ShowAlertMessage('Mohon periksa periode penyampaian');
                return true;
            }
 
            if (triwulanAkhir_4 < triwulanMulai_4) {
                ShowAlertMessage('Mohon periksa periode penyampaian');
                return true;
            }
    
        } else if (periodeLaporan == 'Semesteran'){
            var semester1Mulai = parseInt($('#periodeMulaiFormSemester1').val());
            var semester1Akhir = parseInt($('#periodeAkhirFormSemester1').val());

