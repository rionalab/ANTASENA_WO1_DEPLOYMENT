    function tipePeriodeChange() {
        const v = document.getElementById("PeriodType").value

        toggleForm("DF", v);

        if (v === "Harian") {
            JumlahHariPelaporan();
        }

        setRequired();
    }

    function cbPeriodeKoreksi() {
        if (document.getElementById('cb_usekoreksi').checked) {
            $("#ddHKoreksi").attr("required","");
            $("#txtJamBukaKoreksi").attr("required","");
            $("#txtJamTutupKoreksi").attr("required","");

            $("#ddHKoreksi").prop("disabled", false);
            $("#txtJamBukaKoreksi").prop("disabled", false);
            $("#txtJamTutupKoreksi").prop("disabled", false);
        } else {
            $("#ddHKoreksi").removeAttr("required");
            $("#txtJamBukaKoreksi").removeAttr("required");
            $("#txtJamTutupKoreksi").removeAttr("required");

            $("#ddHKoreksi").prop("disabled", true);
            $("#txtJamBukaKoreksi").prop("disabled", true);
            $("#txtJamTutupKoreksi").prop("disabled", true);
        }

    }

    function buildSelector(selector){   
        return selector.split(" ").map(id => `#` + id).join(" ");
    }

    function setRequired() {
        const val = document.getElementById("PeriodType").value

        const requiredMap =  { 
            Harian: [
                "txtJamBukaPelaporan",
                "txtJamTutupPelaporan",
                "ddHKoreksi",
                "txtJamBukaKoreksi",
                "txtJamTutupKoreksi",
            ],
            Mingguan: [
                "ddPP_MonthM1", 
                "ddPP_MonthA1", 
                "ddPP_MonthM2", 
                "ddPP_MonthA2",
                "ddPP_MonthM3", 
                "ddPP_MonthA3", 
                "ddPP_MonthM4", 
                "ddPP_MonthA4",
                "txtPeriodeTerlambat"
            ],
            Bulanan: [
                "ddBPPMulai", 
                "ddBPPAkhir", 
                "txtBPeriodeTerlambat"
            ],
            Triwulanan: [
                "ddT1Mulai", 
                "ddT1Akhir", 
                "ddT2Mulai",
                "ddT2Akhir",
                "ddT3Mulai",
                "ddT3Akhir",
                "ddT4Mulai",
                "ddT4Akhir",
                "txtTPeriodeTerlambat"
            ],
            Semesteran: [
                "tblsemesteran periodeTerlambatSemesterDanTahunan"
            ],
            Tahunan: [
                "tbltahunan periodeTerlambatSemesterDanTahunan"
            ],
        }

        Object.values(requiredMap).flat().forEach(id => {
            $(buildSelector(id)).removeAttr("required");
        });
        document.getElementById("cb_usekoreksi").checked = false;

        if (requiredMap[val]) {
            requiredMap[val].forEach(id => $(buildSelector(id)).attr("required", ""));
        }
    }
</script>

