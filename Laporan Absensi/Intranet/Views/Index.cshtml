        $("#PeriodLap").on("change", function () {
            var iperiode = this.value;

            const els =  { 
                Harian : document.getElementById("div_Harian"),
                Mingguan : document.getElementById("div_Mingguan"),
                Bulanan : document.getElementById("div_Bulanan"),
                Triwulan : document.getElementById("div_Triwulan"),
                Semesteran : document.getElementById("div_Semester"),
                Tahunan : document.getElementById("div_Tahun")
            }

            Object.values(els).forEach(el => {
                el.style.display = "none";
            });

            els[iperiode].style.display = "block";


            if (iperiode == "Harian") {
                $("#txtHarian").attr('required', '');
                $("#dd_pd").val("bataswaktupenyampaian").change();
