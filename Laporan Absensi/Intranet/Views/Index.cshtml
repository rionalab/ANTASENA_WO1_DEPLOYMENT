                                                        <option value="3">Triwulan 3</option>
                                                        <option value="4">Triwulan 4</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-6">
                                                    <select class="form-control input-sm" type="text" required id="dd_TTahun"></select>
                                                </div>
                                            </div>
                                        </div>
                                        <div id="div_Semester" style="display:none">
