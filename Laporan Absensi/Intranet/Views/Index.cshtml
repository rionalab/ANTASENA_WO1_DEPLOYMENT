                                @*<a class="btn btn-primary" id="id-eksCSV" href="@Url.Action("exportCSV", "LapStatusPenyampaian", new {Cakupan="testing123",IdPelapor="ttt543" }, Request.Url.Scheme)"><span class="fa fa-file-excel"></span> Eksport CSV</a>*@
                                @*<button type="button" id="Eks_Excle" class="btn btn-info"><span class="fa fa-file-excel"></span> Ekspor ke Excle</button>*@
                                <button type="submit" id="id_Lihat" class="btn btn-info"><span class="fa fa-search"></span> Lihat</button>
                            </div>
                        </div>
                    </form>

