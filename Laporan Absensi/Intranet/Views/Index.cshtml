<script>

     function loadKeterangan() {
         var idata = {
             fungsi: "Laporan Absensi"
         }
         $.ajax({
             type: 'POST',
             url: '@Url.Action("getKeterangan", "LapAbsensi", null, Request.Url.Scheme)',
             data: idata,
             dataType: 'JSON',
            beforeSend: function (a) {
            },
            success: function (e) {
                reloadlogin(e);
                var data = e.data;
                var html = "<tbody>";

                html = html + '<tr><td align="center"><span><b>Icon</b></span></td>';
                html = html + '<td align="center"><span><b>Keterangan</b></span></td></tr>';
                for (var i = 0; i < data.length; i++) {
                    var tmpket = data[i].ket;
                    if (tmpket == "Tepat Waktu Menyampaikan Laporan") tmpket = "Tepat Waktu Menyampaikan Laporan/Koreksi";
                    html = html + '<tr><td align="center"><button style="background-color:' + data[i].warna + '" class="btn btn-sm"><span class="' + data[i].icon +'"></span></button></td>';
                        html = html + '<td><span>' + tmpket+'</span></td></tr>';
                }
                html = html +"</tbody>";

                $("#tableKeterangan").html(html);
            },
            complete: function (b) {
            }
         });

     }

    var ijnsKegiatan= "",isandiBank="";
     $("#fm_InputLSP").submit(function (e) {
         e.preventDefault();
         var dd_Bank = $("#dd_Bank").multipleSelect('getSelects');
         //var dd_KelInformasi = $("#dd_KelInformasi").multipleSelect('getSelects');
         var dd_wilayahkerja = $("#wilayahkerja").multipleSelect('getSelects');
         var dd_StatusPLap = $("#StatusPLap").multipleSelect('getSelects');
         if (Object.keys(dd_Bank).length == 0) {
             $("#dd_Bank").multipleSelect('open');
         //} else if (Object.keys(dd_KelInformasi).length == 0) {
         //    $("#dd_KelInformasi").multipleSelect('open');
         } else if (Object.keys(dd_wilayahkerja).length == 0) {
             $("#wilayahkerja").multipleSelect('open');
         } else if (Object.keys(dd_StatusPLap).length == 0) {
             $("#StatusPLap").multipleSelect('open');
         } else {
             loadGrid(); 
             ijnsKegiatan = $("#dd_JenisKegiatan").val();
             isandiBank = $("#dd_SandiBank").val();
         }
     });

    var htmlpg = "", ishow="0",ito="0",iof="0";
     function loadGrid() {
         var flag,iitbl;
         document.getElementById("div-dtTbl").style = "display:none";
         var idata = {
             Cakupan: $("#dd_CakupanDt").val(),
             IdPelapor: $("#dd_Bank").val().join(),
             KelInformasi: $("#dd_KelInformasi").val(),
             //KelInformasi: $("#dd_KelInformasi").val().join(),
             //idinformation: $("#dd_Informasi").val().join(),
             Periode: $("#PeriodLap").val(),
             Harian: $("#txtHarian").val(),
             Minggu: $("#dd_MMinggu").val(),
             MBulan: $("#dd_MBulan").val(),
             MTahun: $("#dd_MTahun").val(),
             BBulan: $("#dd_BBulan").val(),
             BTahun: $("#dd_BTahun").val(),
             Triwulan: $("#dd_Triwulan").val(),
             TTahun: $("#dd_TTahun").val(),
             Semester: $("#dd_Semester").val(),
             STahun: $("#dd_STahun").val(),
             Status: $("#StatusPLap").val().join(),
             wilayahkerja: $("#wilayahkerja").val().join(),
             pdata_penyampaian: $("#dd_pd").val(),
             page: $("#txtpage").val(),
         }
         $.ajax({
             type: 'POST',
             url: '@Url.Action("getList", "LapAbsensi", null, Request.Url.Scheme)',
             data: idata,
             dataType: 'JSON',
             beforeSend: function (a) {
                 $("#id_Lihat").html("<span class='fas fa-spinner fa-spin'></span>").prop("disabled", true);
             },
             success: function (e) {
                 reloadlogin(e);
                var data = e.data;
                flag = e.flag;
                iitbl = e.tbl;
                console.log(e);

                $("#dt_tbl").html('<table id="' + e.tbl + '" class="tableexc table-responsive table-bordered table-striped table-sm" cellspacing="0" width="100%"></table>');
                //$("#dt_tbl").html('<table id="' + e.tbl +'" class="tableexc table-condensed table-sm table-striped table-bordered dataTable no-footer" cellspacing="0" width="100%"></table>');
                $("#" + e.tbl).html(data);
                $("#cpdt").html('<table id="tblexp" class="tableexc d-none">' + data+'</table>');
                 cpdata();

                 if (e.flag) {
                     htmlpg = e.ipage;
                     ishow = e.show;
                     ito = e.to;
                     iof = e.of;
                 }


            },
             complete: function (b) {
                $("#tblexp thead tr").find("p").empty();
                $("#id_Lihat").html("<span class='fas fa-search'></span> Lihat").prop("disabled", false);
                var ittbl= $('#' + iitbl).DataTable({
                    dom: "Bfrti",
                        buttons: [
                        ],
                        ordering: false,
                        paging: false,
                    });
                    document.getElementById("div-dtTbl").style.display = "inline";
                $('#' + iitbl).trigger('click');
                var a = $(".dt-buttons").find(".Pdf");
                 if (a.length == 0) {
                     //20210820 add filter information to download file
                     var pddata;
                     var jeniskeg;
                     var statusclear = "";
                     var statusarr1 = $("#StatusPLap").val();
                     var statusarr = statusarr1.toString().split(",");
                     var mingguan = $("#dd_MMinggu option:selected").text().split(" ");
                     if (statusarr.length > 0) {
                         for (var i = 0; i < statusarr.length; i++) {
                             if (i != statusarr.length - 1) {

                                 statusclear += statusarr[i].substring(2) + ", ";
                             } else {

                                 statusclear += statusarr[i].substring(2) + "";
                             }
                         }
                     } else {
                         statusclear = statusarr;
                     }
                     if ($("#dd_JenisKegiatan").val() == "Pilih Semua") {
                         jeniskeg = "BUK, BUS, UUS";
                     } else {
                         jeniskeg = $("#dd_JenisKegiatan").val();
                     }
                     switch ($("#PeriodLap").val()) {
                         case "Harian":
                             pddata = $("#txtHarian").val();
                             break;
                         case "Mingguan":
                             pddata = mingguan[0] + " ke " + mingguan[1] + ", " + $("#dd_MBulan option:selected").text() + " " + $("#dd_MTahun").val();
                             break;
                         case "Bulanan":
                             pddata = $("#dd_BBulan option:selected").text() + " " + $("#dd_BTahun").val();
                             break;
                         case "Triwulan":
                             pddata = $("#dd_Triwulan option:selected").text() + ", " + $("#dd_TTahun").val();
                             break;
                        case "Semesteran":
                            pddata = $("#dd_Semester option:selected").text() + ", " + $("#dd_STahun").val();
                            break;
                        case "Tahunan":
                            pddata = $("#dd_THTahun").val();
                            break;
                         default:
                             pddata = "";
                     }
                     var param = "KelinfDec=" + btoa($("#dd_KelInformasi").val() //0 Kelompok Informasi
                         + "|" + $("#StatusPLap").val() //1 Status
                         + "|" + $("#dd_CakupanDt option:selected").text() //2 Cakupan
                         + "|" + jeniskeg //3 Jenis Kegiatan
                         + "|" + $("#PeriodLap").val() //4 Periode
                         + "|" + $("#dd_pd option:selected").text() //5 PD
                         + "|" + pddata //6 PD Date
                         + "|" + statusclear); //7 Status Clear
                    var url_Excel = '@Url.Action("ExportToExcel", "LapAbsensi", null, Request.Url.Scheme)?' + param;
                    var url_Csv = '@Url.Action("exportCSV", "LapAbsensi", null, Request.Url.Scheme)?' + param;
                    var url_PDF = '@Url.Action("ExportToPDF", "LapAbsensi", null, Request.Url.Scheme)?' + param;
                    $(".dt-buttons").append('<a href="' + url_Csv + '" class="pdf btn btn-default buttons-excel buttons-html5 btn-sm btn-info" target="_blank"><span>Csv</span></a>')
                    $(".dt-buttons").append('<a href="' + url_Excel+'" class="pdf btn btn-default buttons-excel buttons-html5 btn-sm btn-success" target="_blank"><span>Excel</span></a>')
                    $(".dt-buttons").append('<a href="' + url_PDF + '" class="pdf btn btn-default buttons-pdf buttons-html5 btn-sm btn-danger" target="_blank"><span>PDF</span></a>')
                    //$(".dt-buttons").append('<button type="button" class="pdf btn btn-default buttons-pdf buttons-html5 btn-sm btn-danger" onclick="showPDF()" ><span>PDF</span></a>')
                    $(".dt-buttons").append('<select onchange="setPage(this)" class="form-control input-sm" type="text" required id="dd_Page" name="dd_Page">' + htmlpg + '</select>')
                    $(".dataTables_info").html('Showing ' + ishow + ' to ' + ito + ' of ' + iof + ' entries')
                }

                 $("#dd_Page").val($("#txtpage").val());
            }
         });

    }
    function setPage(e) {
        $("#txtpage").val(e.value);
        loadGrid();
    }
