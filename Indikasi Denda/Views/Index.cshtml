<script>
    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57) && charCode != 45)
            return false;
        return true;
    }

    function formatCurrency(num) {
        num = String(num).replace(/\$|\,/g, '');
        if (isNaN(num))
            num = "0";
        sign = (num == (num = Math.abs(num)));
        num = Math.floor(num * 100 + 0.50000000001);
        num = Math.floor(num / 100).toString();
        for (var i = 0; i < Math.floor((num.length - (1 + i)) / 3); i++)
            num = num.substring(0, num.length - (4 * i + 3)) + ',' + num.substring(num.length - (4 * i + 3));
        return (((sign) ? '' : '-') + num);
    }

</script>
<script>
   
    $(document).ready(function () {
      
        $("#ddl_period").on("change", function () {
            
            var ikelInfo = $("#ddl_KelInfor").val();
            var iperiode = $("#ddl_period").val();
            
            if (ikelInfo == "Kelompok Informasi Keuangan" && iperiode == "M") {
                $("#mymodel3").show();
                $("#mymodel2").hide();
            } else if (ikelInfo == "0" || iperiode == "0" ) {
                $("#mymodel2").hide();
                $("#mymodel3").hide();
            } else {
                $("#mymodel3").hide();
                $("#mymodel2").show();
            }
           
        });

        $("#ddl_KelInfor").on("change", function () {

            var ikelInfo = $("#ddl_KelInfor").val();
            var iperiode = $("#ddl_period").val();
            if (ikelInfo == "Kelompok Informasi Keuangan" && iperiode == "M") {
                $("#mymodel3").show();
                $("#mymodel2").hide();
              
            } else if (ikelInfo == "0" || iperiode == "0") {

                $("#mymodel2").hide();
                $("#mymodel3").hide();
            } else {
                $("#mymodel3").hide();
                $("#mymodel2").show();
            }

        });

        $("#dataTableDenda").on("click", "button.view", function () {
            $("#dd_location").removeAttr('multiple');
            $("#formInputHld")[0].reset();

            getdataIndikasiDenda(this.id);
        });

       
        $("#btnAdd").on("click", function () {
            $("#ddl_KelInfor").attr("disabled", false); 
            $("#ddl_KelInfor").attr("title", "");
            $("#ddl_period").attr("disabled", false); 
            $("#mymodel2").hide();
            $("#mymodel3").hide();
            $("#idDenda").val(0);
            $("#formInputHld")[0].reset();

            $(".modal-title").text("Tambah Indikasi Denda");
            $("#myModal").modal({
                backdrop: "static",
                keyboard: false
            });
        })

        $("#formInputHld").submit(function (e) {

            senddt(this);
            e.preventDefault();
        });

       
        //console.log();
    });

     function getdataIndikasiDenda(id) {
        $.ajax({
            type: 'GET',
            url: '@Url.Action("/", "IndikasiDenda", null, Request.Url.Scheme)getListId/'+id  ,
            dataType:'JSON',
            success: function (data) {
                console.log(data);
                setEditValue(data.data[0]);
            },
            complete: function () {
                $(".modal-title").text("Ubah Indikasi Denda");
                $("#myModal").modal({
                    backdrop: "static",
                    keyboard: false
                });
            }
        });
    }
    function setEditValue(data) {
        document.getElementById("idDenda").value = data.DendaId;
        $("#idDenda").val(data.DendaId);
        $("#ddl_KelInfor").val(data.KelompokInformasi);
        $("#ddl_KelInfor").attr("disabled", "disabled"); 
        $("#ddl_KelInfor").attr("title", $("#ddl_KelInfor").val()); 
        $("#ddl_period").val(data.TipePeriodeLaporan);
        $("#ddl_period").attr("disabled", "disabled"); 
        $("#Id_lapperhari").val(formatCurrency(data.TerlambatMenyampaikanLaporanPerHari));

        $("#Id_koreksiperhari").val(formatCurrency(data.TerlambatMenyampaikanKoreksiPerHari));
        $("#Id_menyampaikanperhari").val(formatCurrency(data.TidakMenyampaikanLaporan));
        $("#Id_inisiatifperhari").val(formatCurrency(data.KoreksiInisiatifSendiriPerBaris));
        $("#Id_Otoritasperhari").val(formatCurrency(data.KoreksiTemuanOtoritasPerBaris));
        $("#Id_AuditKAPperhari").val(formatCurrency(data.KoreksiAuditKAPPerBaris));
       
        var a = data.KelompokInformasi;
        var b = data.TipePeriodeLaporan;
        if (a == "Kelompok Informasi Keuangan" && b == "M") {
            $("#mymodel2").hide();
            $("#mymodel3").show();
            $("#Id_kc301").val(formatCurrency(data.KC30InitiatifSendiri));
            $("#Id_kc30kantor1").val(formatCurrency(data.KC30100InitiatifSendiri));
            $("#Id_kc100kantor1").val(formatCurrency(data.KC100InitiatifSendiri));
            $("#Id_kcmaxkantor1").val(formatCurrency(data.KCmaxInisiatifSendiri));
            $("#Id_kc302").val(formatCurrency(data.KC30TemuanOtoritas));
            $("#Id_kc30kantor2").val(formatCurrency(data.KC30100TemuanOtoritas));
            $("#Id_kc100kantor2").val(formatCurrency(data.KC100TemuanOtoritas));
            $("#Id_kcmaxkantor2").val(formatCurrency(data.KCmaxTemuanOtoritas));

            $("#Id_kc303").val(formatCurrency(data.KC30AuditKAP));
            $("#Id_kc30kantor3").val(formatCurrency(data.KC30100AuditKAP));
            $("#Id_kc100kantor3").val(formatCurrency(data.KC100AuditKAP));
            $("#Id_kcmaxkantor3").val(formatCurrency(data.KCmaxAuditKAP));

        } else {
            $("#mymodel2").show();
            $("#mymodel3").hide();
            $("#Id_sediriperhari").val(formatCurrency(data.MaxKoreksiInisiatifSendiriPerBank));
            $("#Id_tamuOtoperhari").val(formatCurrency(data.MaxKoreksiTemuanOtoritasPerBank));
            $("#Id_Auditperhari").val(formatCurrency(data.MaxKoreksiAuditKAPPerBank));
            
        }

    }


