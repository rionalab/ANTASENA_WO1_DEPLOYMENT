        $("#dd_MMinggu").select2('val', '@ViewBag.Minggu');
        $("#dd_MBulan").select2('val', '@ViewBag.MBulan');
        $("#dd_MTahun").select2('val', '@ViewBag.MTahun');
        $("#dd_BBulan").select2('val', '@ViewBag.BBulan');
        $("#dd_BTahun").select2('val', '@ViewBag.BTahun');
