        $("#dd_Semester").select2('val', '@ViewBag.Semester');
        $("#dd_STahun").select2('val', '@ViewBag.STahun');
        getDD_WilayahKerja('@ViewBag.wilayahkerja','1');
    }
    function lihat() {
        setTimeout(function () {
            if ($("#dd_Bank").val() == "" || $("#wilayahkerja").val() == "") {
            //if ($("#dd_Bank").val() == "" || $("#dd_Informasi").val() == "" || $("#wilayahkerja").val() == "") {
                lihat();
            } else {
                $('#id_Lihat').trigger('click');
                //setToExport();
            }
        }, 100);
    }

