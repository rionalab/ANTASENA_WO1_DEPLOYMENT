                    z.Status = $("#StatusPLap").val().join();
                },
            },
            dom: "Bfrtip",
            buttons: [
                {
                    extend: "csv",
                    className: "btn-sm btn-info",
                    fieldSeparator:";",
                    exportOptions: {
                        format: {
                            header: function (data, columnIdx) {
                                return (columnIdx > 6) ? 'Jumlah Baris ' + data : data;
                            }
                        }
                    }
                },
                {
                    extend: "excel",
                    className: "btn-sm btn-success",
                    exportOptions: {
                        format: {
                            header: function (data, columnIdx) {
                                return (columnIdx > 6) ? 'Jumlah Baris ' + data : data;
                            }
                        }
                    }
                },
                {
                    extend: "pdfHtml5",
